# ── Agent wallet (payer) ───────────────────────────────
# The agent pays USDT from this key. On the in-process Hardhat network this is ignored.
PRIVATE_KEY=

# ── BNB Chain RPC (optional; defaults to public endpoints) ──
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_RPC=https://bsc-dataseed.bnbchain.org

# ── Settlement / off-ramp ──────────────────────────────
# Address that receives the USDT on-chain. In production this is the PSP/off-ramp
# bridge (e.g. TransFi) that converts USDT -> IDR and pays the QRIS merchant.
SETTLEMENT_ADDRESS=

# ── Live FX (optional) ─────────────────────────────────
# Leave empty to use the static demo rate (1 BUSD = 16,000 IDR).
# Set to "coingecko" to fetch live IDR/stablecoin rates from the
# public CoinGecko API at run time (no API key needed).
RATE_SOURCE=

# ── x402 / MPP (optional) ──────────────────────────────
# A URL protected by a 402 Payment Required (mppx) challenge. When set, the agent
# can pay via createHashCredential instead of a plain transfer. Requires a server
# running @bnb-chain/mpp/examples/charge-server.
MPP_PROTECTED_URL=

# ── MPP server signing secret ─────────────────────────
# Required in production (NODE_ENV=production). If unset, the charge server
# will refuse to start. In local dev, a demo key is used with a warning.
MPP_SECRET_KEY=
